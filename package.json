{
  "name": "kernmind-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "The Open-Source, Privacy-First AI Second Brain. A 100% self-hosted, BYOK alternative to MyMind.",
  "scripts": {
    "dev": "pnpm --filter kernmind-web dev",
    "build": "pnpm --filter kernmind-web build",
    "start": "pnpm --filter kernmind-web start",
    "lint": "pnpm --filter kernmind-web lint",
    "desktop": "pnpm --filter kernmind-desktop start",
    "desktop:build": "pnpm --filter kernmind-desktop build"
  },
  "keywords": [
    "mymind-alternative",
    "second-brain",
    "open-source",
    "ai-bookmarks",
    "smart-spaces",
    "byok",
    "self-hosted",
    "reader-mode",
    "ocr",
    "color-palette"
  ],
  "author": "Clemens J. Lechner",
  "license": "MIT",
  "packageManager": "pnpm@11.9.0"
}
