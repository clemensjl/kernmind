# ==============================================================================
# OpenMind Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Cloud Database (Turso / LibSQL - Recommended for Vercel & Production)
# Create a free cloud database at https://turso.tech in 30 seconds
# ------------------------------------------------------------------------------
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-jwt-auth-token

# (If neither TURSO_DATABASE_URL nor DATABASE_URL is set, OpenMind automatically
# uses a local SQLite file in ./data/openmind.db for zero-config offline use)

# ------------------------------------------------------------------------------
# 2. Bring Your Own Key (BYOK) AI Keys (Optional here or configured in UI)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Ollama local URL (if running local models)
OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------------------------
# 3. App Settings
# ------------------------------------------------------------------------------
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
